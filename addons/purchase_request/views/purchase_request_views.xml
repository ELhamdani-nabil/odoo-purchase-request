<odoo>
    <record id="purchase_request_view_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="vendor_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_view_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Soumettre"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approuver"
                            class="btn-primary" invisible="state != 'to_approve'"
                            groups="purchase_request.group_purchase_request_manager"/>
                    <button name="action_reject" type="object" string="Refuser"
                            invisible="state != 'to_approve'"
                            groups="purchase_request.group_purchase_request_manager"/>
                    <button name="action_create_po" type="object"
                            string="Créer le bon de commande" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="purchase_request_action" model="ir.actions.act_window">
        <field name="name">Demandes d'achat</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_request_root"
              name="Demandes d'achat"
              action="purchase_request_action"
              sequence="10"/>
</odoo>