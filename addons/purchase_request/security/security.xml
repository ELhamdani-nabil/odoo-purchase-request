<odoo>
    <record id="group_purchase_request_user" model="res.groups">
        <field name="name">Demande d'achat : Utilisateur</field>
    </record>

    <record id="group_purchase_request_manager" model="res.groups">
        <field name="name">Demande d'achat : Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_user'))]"/>
    </record>

    <record id="group_purchase_request_director" model="res.groups">
        <field name="name">Demande d'achat : Direction</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_manager'))]"/>
    </record>

    <!-- L'administrateur devient automatiquement Direction (donc Manager) -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_director'))]"/>
    </record>

    <!-- Un utilisateur ne voit que ses propres demandes -->
    <record id="rule_purchase_request_user" model="ir.rule">
        <field name="name">Demande d'achat : ses propres demandes</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_request_user'))]"/>
    </record>

    <!-- Un manager (et la Direction) voit toutes les demandes -->
    <record id="rule_purchase_request_manager" model="ir.rule">
        <field name="name">Demande d'achat : toutes les demandes (manager)</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_request_manager'))]"/>
    </record>
</odoo>